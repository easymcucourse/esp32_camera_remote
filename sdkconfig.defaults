CONFIG_IDF_TARGET="esp32s3"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
# Prefer PSRAM for Wi-Fi dynamic buffers and lwIP allocations. Keep DMA-only
# RX buffers and the internal reserve at the measured baseline in this stage.
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=6
# IDF requires static TX with PSRAM preference. Six DMA buffers plus the
# PSRAM cache avoid the 16-buffer default consuming the font-init headroom.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=32
# PSRAM preference also changes this default to unlimited: keep it bounded.
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_FREERTOS_HZ=1000
# FreeType's rasterizer needs 16 KiB. Measured startup uses under 19 KiB;
# 24 KiB retains over 5 KiB headroom while lowering the boot heap peak.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
# CONFIG_BT_ENABLED is not set
