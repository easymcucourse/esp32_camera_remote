# Current developer firmware only. Saved full info, settings off and SIM off.
# Enter NORMAL through settings before benchmarking when no live frame exists.
# Each benchmark pauses the camera and displays 20 synthetic 1024x576 JPEGs.
# Frame rate measures local display work, not the camera/network pipeline.
wait 4000
status
expect "settings=0"
expect "sim=0"
expect "info=full"
S
S
status
expect "settings=0"
display bench
expect "synthetic=1 frames=20" 35
S
display bench
expect "synthetic=1 frames=20" 35
S
display bench
expect "synthetic=1 frames=20" 35
atom sim on
!lcd display bench
atom sim off
status
expect "settings=0"
expect "sim=0"
expect "heap min_internal="
